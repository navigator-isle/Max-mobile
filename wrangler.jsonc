// Cloudflare settings for Max's backend (the Worker "max-ai-backend").
// Deploy with:  npx wrangler deploy   (or double-click deploy.bat / run ./deploy.sh)
// This one Worker serves Max's phone app AND his backend, so nothing depends on GitHub.
// Nothing secret is in this file: GEMINI_API_KEY and MAX_PASSCODE stay as Cloudflare secrets.
{
  "name": "max-ai-backend",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  // Keep the plain-text variables set in the dashboard (ALLOWED_ORIGIN, GEMINI_MODEL).
  "keep_vars": true,
  // Only the real Max adds the notes Claude prepared for Mark (tests and copies don't).
  "vars": { "MAX_SEED_NOTES": "on" },
  // Max's long-term memory database. The code uses the name MAX_MEMORY.
  "d1_databases": [
    {
      "binding": "MAX_MEMORY",
      "database_name": "max-memory",
      "database_id": "ff30b39a-aea5-4d5a-ba42-0a2274789967"
    }
  ],
  // Free backup brain (Cloudflare Workers AI) — used only when Gemini's daily limit is used up.
  "ai": { "binding": "AI" },
  // Hourly at :45 — emails you new paper-trading updates (only if you keep trading emails on).
  "triggers": { "crons": ["45 * * * *"] },
  "observability": { "enabled": true },
  // Max's phone app (built into ./site by build.mjs). Files are served directly; /api/* and /health go to worker.js.
  // _src/ holds a private copy of Max's code for backups — the Worker answers those paths itself and never serves them.
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/_src/*"] }
}
